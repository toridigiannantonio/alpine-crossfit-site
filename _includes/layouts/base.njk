<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Google Analytics 4 (gtag.js) — Alpine CrossFit property -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZWW65KCPPS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZWW65KCPPS');
  </script>

  <!-- Meta Pixel — Alpine CrossFit -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '157318171878891');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=157318171878891&ev=PageView&noscript=1" /></noscript>

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  {# The `noindex` flag previously only suppressed the WebPage schema and kept
     the page out of the sitemap — it never emitted an actual robots tag, so
     /intro/ relied on a hand-written one in `extraHead`. It emits the real
     tag now. "follow" is deliberate: the daily notes are not worth indexing,
     but the links out of them to /crossfit/, /pricing/ and the rest still
     count. #}
  {% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}
  <link rel="icon" type="image/png" href="/assets/img/favicon.png?v={{ site.faviconVersion }}">
  <link rel="apple-touch-icon" href="/assets/img/favicon.png?v={{ site.faviconVersion }}">
  <meta property="og:image" content="{{ ogImage or (site.url + '/assets/img/hero-alpine-wall.jpg') }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Barlow+Condensed:ital,wght@1,700;1,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css?v={{ site.cssVersion }}">
  {% include "partials/schema-org.njk" %}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body>

{% include "partials/header.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

{# Mobile sticky bar — the most persistent CTA on a phone, so it carries both
   doors rather than only the free one. It used to offer the intro plus a
   tap-to-call; the call is still one tap away in the footer and on /visit/,
   and someone who already trains needs the paid option in front of them. #}
<div class="sticky-cta">
  <div class="sticky-cta-inner">
    <a class="btn btn-primary" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
    <a class="btn btn-primary" href="{{ site.pricing.visitOptions[1].ctaHref }}" target="_blank" rel="noopener">Drop in — {{ site.pricing.visitOptions[1].price }}</a>
  </div>
</div>

<!-- Netlify Identity widget — loaded sitewide so password-recovery and
     invitation links work no matter what page the user lands on. -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function (user) {
      if (!user) {
        window.netlifyIdentity.on("login", function () {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

<script src="/assets/js/main.js?v={{ site.mainJsVersion }}" defer></script>
{% if loadImagesScript %}<script src="/assets/js/images.js?v={{ site.imagesJsVersion }}" defer></script>{% endif %}
{% if loadArchiveScript %}<script src="/assets/js/blog-archive.js?v={{ site.archiveJsVersion }}" defer></script>{% endif %}
</body>
</html>
