---
layout: layouts/base.njk
schemaTypes: ["website", "organization", "healthclub"]
loadImagesScript: true
speakable: true
---
{# Homepage layout — rebuilt in the 2026 simplification.
   Eleven sections became six. Nothing was deleted from the SITE; the
   duplicated blocks were removed from the HOMEPAGE and now live only on the
   page that owns them:

     - the full pricing table  -> /pricing/  (here: a one-line price strip)
     - the full class schedule -> /schedule/ (here: a link)
     - the FAQ accordion       -> /faq/      (here: a link)
     - "Who Alpine is for" and "Getting started" merged into one section
     - services became compact link tiles instead of six full cards
     - two of three testimonials dropped; one featured review + the stat row

   Front matter expected:
     - hero: { eyebrow, heading, dek, cta{label,href}, links[{label,href}],
               image{src,alt,slot}, trustItems[] }
     - affiliations: [ { image, alt, label } ]
     - intro: { eyebrow, heading, body[], cards[{heading, body}], steps[{heading, body}] }
     - services: { eyebrow, heading, items[{ heading, note, link }] }
     - pricing: { eyebrow, heading, note, moreLink{label,href} }
     - proof: { eyebrow, heading, featured{quote, attribution}, stats[{value,label}] }
     - visit: { eyebrow, heading, body }
     - finalCta: { heading, body, ctas[{ label, href, inlineStyle }] }
#}

{% if announcement %}
<!-- ANNOUNCEMENT BANNER -->
<section class="announcement-banner" style="background: var(--color-alpine-green); color: var(--color-black); padding: 10px 0; text-align: center;">
  <div class="container">
    <p style="margin: 0; font-size: 14px; line-height: 1.5;">
      {% if announcement.eyebrow %}<strong>{{ announcement.eyebrow }}</strong> — {% endif %}{{ announcement.text | safe }}
      {% if announcement.href %}<a href="{{ announcement.href }}" style="color: var(--color-black); font-weight: 600; text-decoration: underline; margin-left: 6px;">{{ announcement.linkLabel or 'Read more →' }}</a>{% endif %}
    </p>
  </div>
</section>
{% endif %}

<!-- 1. HERO — one sentence, ONE button, secondary actions as text links -->
<section class="hero">
  <div class="container hero-with-image">
    <div class="hero-text">
      {% if hero.eyebrow %}<div class="hero-eyebrow">{{ hero.eyebrow }}</div>{% endif %}
      <h1>{{ hero.heading | safe }}</h1>
      {% if hero.dek %}<p class="hero-dek">{{ hero.dek | safe }}</p>{% endif %}
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
      </div>
      {% if hero.links %}
      <div class="hero-links">
        {%- for l in hero.links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}
      </div>
      {% endif %}
      {% if hero.trustItems %}
      <div class="trust-strip">
        {%- for t in hero.trustItems %}
          {%- if t.type == 'stars' %}<span class="stars">★★★★★</span>{% endif -%}
          {%- if t.text %}<span>{{ t.text | safe }}</span>{% endif -%}
          {%- if not loop.last %}<span class="sep">·</span>{% endif -%}
        {%- endfor %}
      </div>
      {% endif %}
    </div>
    <div class="hero-media">
      <img src="{{ hero.image.src }}" alt="{{ hero.image.alt }}" class="hero-image" loading="eager" fetchpriority="high"{% if hero.image.slot %} data-image-slot="{{ hero.image.slot }}"{% endif %}>
    </div>
  </div>
</section>

{% if affiliations %}
<section class="affiliations">
  <div class="container">
    <div class="affiliations-row">
      {%- for a in affiliations %}
      <div class="affiliation-item">
        <img src="{{ a.image }}" alt="{{ a.alt }}" class="affiliation-badge">
        <div class="affiliation-label">{{ a.label | safe }}</div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if intro %}
<!-- 2. WHO IT'S FOR + HOW TO START, merged into one section -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{{ intro.eyebrow }}</span>
    <h2 class="section-heading">{{ intro.heading }}</h2>
    <div class="split">
      <div>
        {%- for para in intro.body %}
        <p>{{ para | safe }}</p>
        {%- endfor %}
        {% if intro.cards %}
        <ul class="feature-list mt-6">
        {%- for c in intro.cards %}
          <li><strong>{{ c.heading }}</strong> — {{ c.body | safe }}</li>
        {%- endfor %}
        </ul>
        {% endif %}
      </div>
      <div>
        <h3>{{ intro.stepsHeading or 'Getting started' }}</h3>
        <ol class="feature-list" style="list-style-type: decimal;">
        {%- for s in intro.steps %}
          <li><strong>{{ s.heading }}</strong> {{ s.body | safe }}</li>
        {%- endfor %}
        </ol>
        <div class="mt-6">
          <a class="btn btn-primary" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if services %}
<!-- 3. SERVICES — compact link tiles, not full cards -->
<section class="section section-dark">
  <div class="container">
    <span class="eyebrow">{{ services.eyebrow }}</span>
    <h2 class="section-heading">{{ services.heading }}</h2>
    <div class="grid-tiles">
    {%- for item in services.items %}
      <a class="tile" href="{{ item.link }}">
        <span class="tile-title">{{ item.heading }}</span>
        <span class="tile-note">{{ item.note }}</span>
      </a>
    {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if pricing %}
<!-- 4. PRICING — a one-line strip, built from site.pricing. The full table
     lives on /pricing/, which owns it. -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{{ pricing.eyebrow }}</span>
    <h2 class="section-heading">{{ pricing.heading }}</h2>
    <div class="price-strip">
      {%- for t in site.pricing.tiers %}
      <span class="price-strip-item">
        <span class="price-strip-amount">{{ t.price }}</span>
        <span class="price-strip-label">{{ t.name }}</span>
      </span>
      {%- endfor %}
    </div>
    {% if pricing.note %}<p class="text-muted mt-4" style="font-size:0.9rem;">{{ pricing.note | safe }}</p>{% endif %}
    <p class="mt-4"><a href="{{ pricing.moreLink.href }}">{{ pricing.moreLink.label }}</a></p>
  </div>
</section>
{% endif %}

{% if proof %}
<!-- 5. PROOF — one featured review plus the stat row (was three testimonials) -->
<section class="section section-dark">
  <div class="container">
    <span class="eyebrow">{{ proof.eyebrow }}</span>
    <h2 class="section-heading">{{ proof.heading }}</h2>
    <div class="testimonial">
      <div class="testimonial-stars">★★★★★</div>
      <p class="testimonial-quote">"{{ proof.featured.quote | safe }}"</p>
      <div class="testimonial-attribution">— {{ proof.featured.attribution | safe }}</div>
    </div>
    {% if proof.stats %}
    <div class="stat-row mt-8">
    {%- for s in proof.stats %}
      <div class="stat">
        <div class="stat-value">{{ s.value }}</div>
        <div class="stat-label">{{ s.label }}</div>
      </div>
    {%- endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if visit %}
<!-- 6. VISIT — the shared location card plus links. The full schedule grid
     lives on /schedule/. -->
<section class="section" id="visit">
  <div class="container">
    <span class="eyebrow">{{ visit.eyebrow }}</span>
    <h2 class="section-heading">{{ visit.heading }}</h2>
    <div class="split">
      {% include "partials/location-card.njk" %}
      <div>
        {% if visit.body %}<p>{{ visit.body | safe }}</p>{% endif %}
        <div class="hero-links" style="margin-top:var(--space-4);">
          <a href="/schedule/">See the class schedule</a>
          <a href="/visit/">Directions &amp; areas we serve</a>
          <a href="/faq/">All {{ faqs.items.length }} FAQs</a>
        </div>
        <div class="mt-6">
          <a class="btn btn-primary" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if finalCta %}
<section class="section section-green">
  <div class="container text-center">
    <h2>{{ finalCta.heading }}</h2>
    {% if finalCta.body %}<p class="hero-dek" style="margin-left:auto;margin-right:auto;color:rgba(0,0,0,0.8);">{{ finalCta.body | safe }}</p>{% endif %}
    <div class="hero-cta hero-cta-center" style="justify-content:center;">
      <a class="btn btn-lg" style="background:#000;color:#fff;" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
    </div>
  </div>
</section>
{% endif %}
