---
layout: layouts/base.njk
schemaTypes: ["faq", "healthclub"]
speakable: true
---
{# The master FAQ page. It renders every canonical entry in _data/faqs.js,
   grouped by that file's `groups` order — there is no question list in this
   page's front matter to fall out of sync with the rest of the site.

   Its FAQPage JSON-LD comes from `faqIds` computed below, through the same
   faqPick filter every other page uses. #}
<section class="hero">
  <div class="container container-narrow">
    <div class="hero-eyebrow">{{ eyebrow or 'FAQ' }}</div>
    <h1>{{ heading | safe }}</h1>
    {% if dek %}<p class="hero-dek">{{ dek | safe }}</p>{% endif %}
    {% if heroCtas %}
    <div class="hero-cta">
      {%- for cta in heroCtas %}
      <a class="btn {{ cta.style or 'btn-primary btn-lg' }}" href="{{ cta.href }}">{{ cta.label }}</a>
      {%- endfor %}
    </div>
    {% endif %}
  </div>
</section>

{%- for g in faqs.groups %}
<section class="section{% if loop.index0 % 2 %} section-dark{% endif %}" id="{{ g.id }}">
  <div class="container container-narrow">
    <h2>{{ g.heading | safe }}</h2>
    {%- for item in faqs | faqGroup(g.id) %}
    <details class="faq-item"><summary>{{ item.q }}</summary><div class="faq-answer">{{ item.a | safe }}</div></details>
    {%- endfor %}
  </div>
</section>
{%- endfor %}

{% if finalCta %}
<section class="section section-green">
  <div class="container text-center">
    <h2>{{ finalCta.heading }}</h2>
    {% if finalCta.body %}<p class="hero-dek" style="margin-left:auto;margin-right:auto;color:rgba(0,0,0,0.8);">{{ finalCta.body | safe }}</p>{% endif %}
    <div class="hero-cta" style="justify-content:center;">
      {%- for cta in finalCta.ctas %}
      <a class="btn btn-lg" style="{{ cta.inlineStyle or 'background:#000;color:#fff;' }}" href="{{ cta.href }}">{{ cta.label }}</a>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}
