<footer class="site-footer">
  <div class="container">
    {# 12 links across 3 columns. The Areas column went away with the
       five /gym/<city>/ pages; About and Blog moved down here from the
       primary nav. #}
    <div class="footer-grid">
      <div>
        <h4>{{ site.name }}</h4>
        <p>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}<br><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></p>
        <p class="text-muted" style="font-size:0.85rem;">Founded {{ site.founded }} · Under current ownership since {{ site.ownershipSince }}</p>
        <p class="footer-cta">
          <a class="btn btn-primary" href="{{ site.primaryCta.url }}">{{ site.primaryCta.label }}</a>
          <a class="btn btn-primary" href="{{ site.pricing.visitOptions[1].ctaHref }}" target="_blank" rel="noopener">Drop in — {{ site.pricing.visitOptions[1].price }}</a>
        </p>
      </div>
      <div>
        <h4>Train</h4>
        <ul>
        {%- for item in site.footerColumns.train %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        </ul>
      </div>
      <div>
        <h4>Visit</h4>
        <ul>
        {%- for item in site.footerColumns.visit %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        </ul>
        <h4 class="mt-6">About</h4>
        <ul>
        {%- for item in site.footerColumns.about %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© 2026 {{ site.name }}. All rights reserved.</div>
      <div><a href="{{ site.instagram }}">Instagram</a></div>
    </div>
  </div>
</footer>
